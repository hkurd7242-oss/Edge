[Unit]
Description=Edge Cross-Asset Intelligence Refresh Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/edge-intelligence
Environment=PYTHONUNBUFFERED=1
Environment=EDGE_REFRESH_INTERVAL_SECONDS=600
ExecStart=/opt/edge-intelligence/.venv/bin/python /opt/edge-intelligence/worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
